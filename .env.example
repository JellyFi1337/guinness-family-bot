# GUINNESS BOT — секреты и Discord identity (не коммитить).
# Скопируйте в .env, заполните значения. Linux: chmod 600 .env
#
# Каналы / роли / экономика — в bot_config.toml.
# Identity ниже — только здесь (в TOML запрещены).

# --- Какой бот запускать ---
# test  = тестовый бот + тестовый сервер
# main  = семейный основной бот + основной сервер
# Алиасы: family/prod → main, dev → test
BOT_PROFILE=test

# --- Discord: тестовый ---
TOKEN_TEST=
GUILD_ID_TEST=

# --- Discord: семейный основной ---
TOKEN_MAIN=
GUILD_ID_MAIN=

# Владелец команд /setup /admin
BOT_OWNER_ID=

# Одноразовые флаги синхронизации slash-команд (обычно false).
# true только на один запуск, затем верните false.
COMMAND_SYNC_FORCE=false
COMMAND_CLEAR_GLOBAL=false

# Устаревший запасной ключ: используется, если TOKEN_TEST/TOKEN_MAIN пусты.
TOKEN=

# PostgreSQL (локальный python main.py / SSH-туннель).
# В Docker Compose этот URL игнорируется: берётся хост db + secrets/db_password.
DATABASE_URL=postgresql://guinnes_bot:CHANGE_ME@127.0.0.1:5432/guinnes_bot

# Персональный ключ публичного API Majestic. Пустое значение — интеграция выключена.
MAJESTIC_API_KEY=
