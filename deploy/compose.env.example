# Guinness Bot — Compose environment template (not an app .env).
# Copy to deploy/compose.env and pass:
#   docker compose --env-file deploy/compose.env up -d --build
# Or use docker-start.bat / docker-stop.bat from the repo root.
#
# Application secrets + BOT_PROFILE live in ./.env (mounted into the bot).
# Do NOT put Discord tokens in this file.

# Compose project name (containers: <name>-db-1, <name>-bot-1)
COMPOSE_PROJECT_NAME=guinness

# Named volumes / network prefix (keep unique for test vs prod stacks)
COMPOSE_VOLUME_PREFIX=guinness

POSTGRES_USER=guinness
POSTGRES_DB=guinness_bot
TZ=Europe/Moscow

DB_PASSWORD_HOST_PATH=./secrets/db_password

# Optional fallback secret file (may be empty if TOKEN_* are in .env)
TOKEN_HOST_PATH=./secrets/discord_token

# Public TOML (channels/roles). GUILD_ID_* from .env override TOML when set.
BOT_CONFIG_HOST_PATH=./deploy/bot_config.example.toml

# Mounted as /app/.env — BOT_PROFILE, TOKEN_TEST/TOKEN_MAIN, GUILD_ID_*
BOT_ENV_HOST_PATH=./.env

# Image tag built by Compose
BOT_IMAGE_NAME=guinness-bot:compose

# Loopback publish only with: --profile diag
POSTGRES_DIAG_PORT=5432
